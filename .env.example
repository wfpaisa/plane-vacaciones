# Cuenta admin: la crea PocketBase la primera vez que arranca. Se entra con este usuario.
ADMIN_USER=familia
ADMIN_PASSWORD=vacaciones2026

# Cuenta de administración de PocketBase (http://127.0.0.1:8090/_/).
PB_ADMIN_EMAIL=admin@vacaciones.test
PB_ADMIN_PASSWORD=admin-vacaciones-2026

PB_PORT=8091
WEB_PORT=3434

# Google Maps y búsqueda de lugares
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_PLACES_SERVER_KEY=
GOOGLE_MAPS_MONTHLY_LIMIT=8000
# Text Search Pro: límite independiente de búsquedas mensuales.
GOOGLE_PLACES_MONTHLY_LIMIT=4000

# Orígenes de clientes MCP web autorizados, separados por coma.
# Los agentes de servidor sin cabecera Origin no necesitan esta opción.
MCP_ALLOWED_ORIGINS=
